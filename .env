# ═══════════════════════════════════════════
# Wedding Invite — Настройки / Settings
# ═══════════════════════════════════════════

# Автопроигрывание музыки (true / false)
# Music autoplay on first user interaction
NEXT_PUBLIC_MUSIC_AUTOPLAY=true

# Громкость музыки (0.0 – 1.0)
# Music volume level
NEXT_PUBLIC_MUSIC_VOLUME=0.35
